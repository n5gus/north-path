# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated transfer bundles kept outside the repo
/*.zip
/*.patch

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local research cache and uploads
/agent-tools
/uploads
/test-results
/playwright-report
/blob-report
/data/runtime
/data/snapshots/sheets/*.pdf
